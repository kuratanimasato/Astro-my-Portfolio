{
  "name": "portfolio-starter",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "A minimal, professional portfolio starter for Astro — TypeScript, Tailwind CSS v4, Content Collections, dark mode, and full SEO, with no unnecessary dependencies.",
  "keywords": [
    "astro",
    "astro-theme",
    "astro-template",
    "portfolio",
    "tailwindcss",
    "typescript",
    "starter"
  ],
  "license": "MIT",
  "author": "Bracozs",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/portfolio-starter"
  },
  "homepage": "https://github.com/your-username/portfolio-starter",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "eslint": "npm run lint",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "deploy": "git add . && git commit -m 'Update site' && git push origin main"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@types/three": "^0.186.0",
    "aos": "^2.3.4",
    "astro": "^7.0.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/aos": "^3.0.8",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
