---
import 'aos/dist/aos.css';
---

<script>
  import AOS from 'aos';

  const initAOS = () => {
    AOS.init({
      duration: 700,
      easing: 'ease-out-cubic',
      once: true,
      offset: 80,
      disable: () => window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    });
  };

  initAOS();
  document.addEventListener('astro:page-load', () => AOS.refreshHard());
</script>
