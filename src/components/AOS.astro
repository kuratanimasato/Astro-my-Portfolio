---
import 'aos/dist/aos.css';
---

<script>
  import AOS from 'aos';

  const setupAOS = () => {
    AOS.init({
      duration: 550,
      easing: 'ease-out-cubic',
      once: true,
      offset: 80,
      throttleDelay: 16,
      disable: () => window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    });
    AOS.refreshHard();
  };
  document.addEventListener('astro:page-load', () => {
    setupAOS();
  });

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      AOS.refreshHard();
    }
  });
</script>
