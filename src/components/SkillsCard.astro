---
export interface Props {
  name: string;
  level: number;
  icon: string;
}

const { name, level, icon } = Astro.props;
---

<div
  class="border-line bg-paper/60 hover:border-signal/50 relative flex items-center gap-3 rounded-xl border p-3 shadow-xs transition-all duration-200 hover:-translate-y-0.5"
>
  <!-- アイコン表示領域: bg-white / dark:bg-white にしてテーマに関わらず白背景を確保 -->
  <div
    class="border-line/50 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border bg-white p-2 shadow-inner"
  >
    <img src={icon} alt={name} class="h-full w-full object-contain" />
  </div>

  <!-- スキル名 & ★評価 -->
  <div class="flex flex-col justify-between overflow-hidden">
    <span class="text-ink truncate text-xs font-medium sm:text-sm">{name}</span>

    <div class="mt-1 flex items-center gap-0.5 text-xs">
      {
        [1, 2, 3].map((star) => (
          <span class={star <= level ? 'text-amber-400' : 'text-line'}>★</span>
        ))
      }
    </div>
  </div>
</div>
