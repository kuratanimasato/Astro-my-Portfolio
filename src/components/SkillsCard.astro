---
import SectionHeading from '@/components/SectionHeading.astro';
import { SKILL_CATEGORIES } from '@/site.config';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section
  id="skills"
  class="border-line bg-paper/40 min-h-[40vh] rounded-3xl border p-8 shadow-sm backdrop-blur sm:p-12"
>
  <SectionHeading eyebrow={t('nav.skills')} count={SKILL_CATEGORIES.length} />

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      SKILL_CATEGORIES.map((category, index) => (
        <div
          class="border-line bg-paper/80 flex flex-col rounded-2xl border p-6 shadow-sm"
          data-aos="fade-up"
          data-aos-delay={index * 300}
        >
          <h3 class="font-display text-ink mb-4 text-lg font-medium">{category.title}</h3>
          <ul class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <li class="border-line text-ink-soft bg-paper rounded-lg border px-3 py-1.5 font-mono text-xl">
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
