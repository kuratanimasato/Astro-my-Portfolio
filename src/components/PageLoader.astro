---
/* src/components/PageLoader.astro */
---

<!-- ローダー本体 -->
<div
  id="page-loader"
  class="pointer-events-none fixed inset-0 z-[10000] flex flex-col items-center justify-center bg-[#fcfbf9] transition-opacity duration-500"
>
  <div class="h-6 w-6 animate-spin rounded-full border-2 border-indigo-500/20 border-t-indigo-500">
  </div>
  <span class="text-ink/60 mt-3 font-mono text-xs tracking-widest uppercase">Loading</span>
</div>

<script>
  const initLoader = () => {
    const loader = document.getElementById('page-loader');
    if (!loader) return;

    // ① トップページ（/ や /ja/ など）以外は即座に非表示
    const isHomePage =
      window.location.pathname === '/' ||
      window.location.pathname === '/ja' ||
      window.location.pathname === '/ja/';

    // ② すでにこのセッションでローディングを表示済みかチェック
    const hasLoaded = sessionStorage.getItem('hasLoadedTopPage');

    if (!isHomePage || hasLoaded) {
      loader.style.display = 'none';
      return;
    }
    // ③ トップページの初回読み込み時のみ実行
    const hideLoader = () => {
      // 既に非表示処理が始まっていたら二重実行しない
      if (loader.classList.contains('opacity-0')) return;
      loader.classList.add('opacity-0');
      sessionStorage.setItem('hasLoadedTopPage', 'true');

      setTimeout(() => {
        loader.style.display = 'none';
      }, 500); // 500ms（0.5秒）かけてフェードアウト
    };
    // 最低でも800msはローダーを表示させて質感を見せつつ、1.2秒後には確実に非表示化
    setTimeout(hideLoader, 1000);
  };

  initLoader();
  document.addEventListener('astro:page-load', initLoader);
</script>
