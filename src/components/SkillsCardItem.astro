---
import SectionHeading from '@/components/SectionHeading.astro';
import SkillCard from '@/components/SkillsCard.astro';
import { SKILL_CATEGORIES } from '@/site.config';
---

<section
  id="skills"
  class="border-line bg-paper/40 min-h-[40vh] rounded-3xl border p-8 shadow-sm backdrop-blur sm:p-12"
>
  <SectionHeading eyebrow="スキル" />

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      SKILL_CATEGORIES.map((category, index) => (
        <div
          class="border-line bg-paper/80 flex flex-col rounded-2xl border p-6 shadow-sm"
          data-aos="fade-up"
          data-aos-delay={index * 300}
        >
          <h3 class="font-display text-ink mb-4 text-lg font-medium">{category.title}</h3>

          <div class="grid grid-cols-2 gap-3">
            {category.skills.map((skill) => (
              <SkillCard name={skill.name} level={skill.level} icon={skill.icon} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
