---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE } from '@/site.config';

const navItems = [
  { label: 'ホーム', href: '/#home' },
  { label: '私について', href: '/#about' },
  { label: '作品', href: '/#work' },
  { label: 'スキル', href: '/#skills' },
];

const homeHref = '/';
const contactHref = '/#contact';
---

<!-- 外枠：画面全幅（w-full）で固定し、z-50 で最前面へ -->
<header id="site-header" class="sticky top-0 z-50 w-full py-3 transition-all duration-300">
  <!-- 内枠：900pxカプセルデザイン -->
  <div
    class="border-line bg-paper/90 mx-4 max-w-[1100px] rounded-2xl border shadow-md backdrop-blur sm:mx-auto"
  >
    <div class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-6 py-3">
      <a href={homeHref} class="font-display text-ink text-lg font-medium">
        {SITE.name}
      </a>

      <nav class="hidden items-center gap-5 sm:flex" aria-label="Primary">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link text-ink-soft hover:text-ink text-xm font-mono tracking-wide uppercase transition-colors"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={contactHref}
          class="nav-link text-ink-soft hover:text-ink text-xm scrollbar-track-orange-50 font-mono tracking-wide uppercase transition-colors"
        >
          お問い合わせ
        </a>
        <ThemeToggle />
      </nav>

      {/* Mobile Controls */}
      <div class="flex items-center gap-2 sm:hidden">
        <ThemeToggle />
        <button
          type="button"
          id="mobile-menu-button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="メニューを開閉"
          class="text-ink-soft hover:border-signal hover:text-signal border-line flex h-9 w-9 shrink-0 items-center justify-center rounded-full border transition-colors"
        >
          <svg
            class="menu-open-icon h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
          <svg
            class="menu-close-icon hidden h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    {/* Mobile Dropdown Menu */}
    <div
      id="mobile-menu"
      class="border-line bg-paper/95 hidden rounded-b-2xl border-t backdrop-blur sm:hidden"
      aria-label="Mobile Navigation"
    >
      <div class="mx-auto flex max-w-3xl flex-col space-y-3 px-6 py-4">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link text-ink-soft hover:text-ink py-1.5 font-mono text-sm tracking-wide uppercase transition-colors"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={contactHref}
          class="nav-link text-ink-soft hover:text-ink py-1.5 font-mono text-sm tracking-wide uppercase transition-colors"
        >
          お問い合わせ
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function initHeaderScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;

    const handleScroll = () => {
      if (window.scrollY > 20) {
        header.classList.add(
          'bg-paper/40',
          'backdrop-blur-md',
          'shadow-sm',
          'border-b',
          'border-line',
        );
      } else {
        header.classList.remove(
          'bg-paper/40',
          'backdrop-blur-md',
          'shadow-sm',
          'border-b',
          'border-line',
        );
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  function initMobileMenu() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu || button.dataset.bound) return;
    button.dataset.bound = 'true';

    const menuEl = menu;
    const btnEl = button;
    const openIcon = btnEl.querySelector('.menu-open-icon');
    const closeIcon = btnEl.querySelector('.menu-close-icon');

    function toggleMenu(isOpen?: boolean) {
      const willOpen = isOpen ?? menuEl.classList.contains('hidden');
      if (willOpen) {
        menuEl.classList.remove('hidden');
        btnEl.setAttribute('aria-expanded', 'true');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        menuEl.classList.add('hidden');
        btnEl.setAttribute('aria-expanded', 'false');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    btnEl.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    menuEl.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    document.addEventListener('click', (e) => {
      if (!menuEl.contains(e.target as Node) && !btnEl.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });
  }

  function initScrollSpy() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
    const sections = document.querySelectorAll<HTMLElement>('section[id]');

    if (!sections.length || !navLinks.length) return;

    const setActiveLink = (targetId: string | null) => {
      navLinks.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const hashIndex = href.indexOf('#');
        const linkHash = hashIndex !== -1 ? href.substring(hashIndex + 1) : '';

        const isMatch = targetId && linkHash === targetId;

        if (isMatch) {
          link.classList.add('text-signal', 'font-semibold');
          link.classList.remove('text-ink-soft');
          link.setAttribute('aria-current', 'page');
        } else {
          link.classList.remove('text-signal', 'font-semibold');
          link.classList.add('text-ink-soft');
          link.removeAttribute('aria-current');
        }
      });
    };

    const handleScrollSpy = () => {
      // 画面最上部にいる場合は "home" を選択
      if (window.scrollY < 50) {
        setActiveLink('home');
        return;
      }

      // ページ最下部に到達した場合は "contact" または最後のセクションを選択
      const isAtBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 50;
      if (isAtBottom) {
        const lastSectionId = sections[sections.length - 1]?.getAttribute('id');
        if (lastSectionId) {
          setActiveLink(lastSectionId);
          return;
        }
      }

      // 画面中央付近で交差しているセクションを検索
      const centerPoint = window.innerHeight / 3;
      let currentSectionId: string | null = null;

      sections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= centerPoint && rect.bottom >= centerPoint) {
          currentSectionId = section.getAttribute('id');
        }
      });

      if (currentSectionId) {
        setActiveLink(currentSectionId);
      }
    };

    window.addEventListener('scroll', handleScrollSpy, { passive: true });
    handleScrollSpy(); // 初期実行
  }

  document.addEventListener('astro:page-load', () => {
    initHeaderScroll();
    initMobileMenu();
    initScrollSpy();
  });
</script>
