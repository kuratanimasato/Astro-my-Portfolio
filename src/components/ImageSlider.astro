---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: ImageMetadata[];
  title?: string;
  alt?: string;
  class?: string;
}

const { images = [], title = '作品', alt, class: className = '' } = Astro.props;
const hasMultiple = images.length > 1;
const sliderId = `slider-${Math.random().toString(36).substring(2, 9)}`;
---

{
  images.length > 0 && (
    <div class:list={['image-slider-container relative mt-8', className]} id={sliderId}>
      {hasMultiple ? (
        <div
          class="group border-line bg-surface relative overflow-hidden rounded-2xl border"
          role="region"
          aria-roledescription="carousel"
          aria-label={`${title}の画像ギャラリー`}
          tabindex="0"
        >
          {/* Slides Track */}
          <div
            class="slider-track flex snap-x snap-mandatory [scrollbar-width:none] overflow-x-auto scroll-smooth [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
            tabindex="-1"
          >
            {images.map((img, index) => (
              <div
                class="slider-slide relative w-full shrink-0 snap-center"
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} / ${images.length}`}
                data-index={index}
              >
                <Image
                  src={img}
                  alt={alt || `${title}の画像 ${index + 1}`}
                  class="aspect-[16/10] w-full object-cover sm:aspect-[16/9]"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))}
          </div>

          {/* Navigation Arrows */}
          <button
            type="button"
            class="slider-prev border-line bg-paper/85 text-ink hover:text-signal hover:bg-paper focus-visible:outline-signal absolute top-1/2 left-3 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border opacity-90 shadow-md backdrop-blur-sm transition-all duration-200 disabled:cursor-not-allowed disabled:opacity-30 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100"
            aria-label="前の画像"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          <button
            type="button"
            class="slider-next border-line bg-paper/85 text-ink hover:text-signal hover:bg-paper focus-visible:outline-signal absolute top-1/2 right-3 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border opacity-90 shadow-md backdrop-blur-sm transition-all duration-200 disabled:cursor-not-allowed disabled:opacity-30 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100"
            aria-label="次の画像"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          {/* Slide Counter Badge */}
          <div class="border-line bg-paper/85 text-ink-soft absolute top-3 right-3 z-10 rounded-full border px-2.5 py-0.5 font-mono text-[11px] shadow-sm backdrop-blur-sm select-none">
            <span class="slider-current text-ink font-medium">1</span> /{' '}
            <span class="slider-total">{images.length}</span>
          </div>

          {/* Dots Pagination */}
          <div class="slider-dots border-line bg-paper/80 absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 items-center gap-1.5 rounded-full border px-2.5 py-1.5 backdrop-blur-sm">
            {images.map((_, index) => (
              <button
                type="button"
                class:list={[
                  'slider-dot h-2 rounded-full transition-all duration-300',
                  index === 0 ? 'bg-signal w-5' : 'bg-ink-soft/40 hover:bg-ink-soft w-2',
                ]}
                data-target-index={index}
                aria-label={`スライド ${index + 1} に移動`}
                aria-current={index === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
        </div>
      ) : (
        <div class="border-line overflow-hidden rounded-2xl border">
          <Image
            src={images[0]}
            alt={alt || `${title}の画像`}
            class="aspect-[16/10] w-full object-cover sm:aspect-[16/9]"
          />
        </div>
      )}
    </div>
  )
}

<script>
  function setupSliders() {
    const sliders = document.querySelectorAll<HTMLElement>('.image-slider-container');

    sliders.forEach((container) => {
      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const track = container.querySelector<HTMLElement>('.slider-track');
      const slides = container.querySelectorAll<HTMLElement>('.slider-slide');
      const prevBtn = container.querySelector<HTMLButtonElement>('.slider-prev');
      const nextBtn = container.querySelector<HTMLButtonElement>('.slider-next');
      const currentEl = container.querySelector<HTMLElement>('.slider-current');
      const dots = container.querySelectorAll<HTMLButtonElement>('.slider-dot');

      if (!track || slides.length <= 1) return;

      let currentIndex = 0;

      const updateUI = (index: number) => {
        currentIndex = Math.max(0, Math.min(index, slides.length - 1));

        if (currentEl) {
          currentEl.textContent = String(currentIndex + 1);
        }

        dots.forEach((dot, i) => {
          if (i === currentIndex) {
            dot.classList.remove('w-2', 'bg-ink-soft/40');
            dot.classList.add('w-5', 'bg-signal');
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.classList.remove('w-5', 'bg-signal');
            dot.classList.add('w-2', 'bg-ink-soft/40');
            dot.setAttribute('aria-current', 'false');
          }
        });
      };

      const scrollToIndex = (index: number) => {
        const targetSlide = slides[index];
        if (targetSlide) {
          track.scrollTo({
            left: targetSlide.offsetLeft,
            behavior: 'smooth',
          });
          updateUI(index);
        }
      };

      prevBtn?.addEventListener('click', () => {
        const nextIndex = currentIndex > 0 ? currentIndex - 1 : slides.length - 1;
        scrollToIndex(nextIndex);
      });

      nextBtn?.addEventListener('click', () => {
        const nextIndex = currentIndex < slides.length - 1 ? currentIndex + 1 : 0;
        scrollToIndex(nextIndex);
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const targetIndex = Number(dot.dataset.targetIndex);
          if (!isNaN(targetIndex)) {
            scrollToIndex(targetIndex);
          }
        });
      });

      // Keyboard navigation
      container.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          const nextIndex = currentIndex > 0 ? currentIndex - 1 : slides.length - 1;
          scrollToIndex(nextIndex);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          const nextIndex = currentIndex < slides.length - 1 ? currentIndex + 1 : 0;
          scrollToIndex(nextIndex);
        }
      });

      // Track scroll observer / scroll listener for touch swipe
      let scrollTimeout: ReturnType<typeof setTimeout> | null = null;
      track.addEventListener(
        'scroll',
        () => {
          if (scrollTimeout) clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            const scrollLeft = track.scrollLeft;
            const trackWidth = track.clientWidth;
            if (trackWidth > 0) {
              const newIndex = Math.round(scrollLeft / trackWidth);
              if (newIndex !== currentIndex && newIndex >= 0 && newIndex < slides.length) {
                updateUI(newIndex);
              }
            }
          }, 50);
        },
        { passive: true },
      );
    });
  }

  // Support initial load and Astro View Transitions
  document.addEventListener('astro:page-load', setupSliders);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSliders);
  } else {
    setupSliders();
  }
</script>
