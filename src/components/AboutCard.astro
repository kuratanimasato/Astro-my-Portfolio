---
import SectionHeading from '@/components/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section
  id="about"
  class="border-line bg-paper/40 rounded-3xl border p-8 shadow-sm backdrop-blur sm:p-12"
>
  <SectionHeading eyebrow={t('home.aboutEyebrow')} />
  <p class="text-ink-soft max-w-xl">
    {t('site.description')}
  </p>
  <a
    href={getRelativeLocaleUrl(currentLang, 'about')}
    class="text-signal mt-4 inline-block font-mono text-xs hover:underline"
  >
    {t('home.aboutMore')}
  </a>
</section>
