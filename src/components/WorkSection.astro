---
import SectionHeading from '@/components/SectionHeading.astro';
import WorkRow from '@/components/WorkRow.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  allWorkCount: number;
  selectedWork: CollectionEntry<'work'>[];
}

const { allWorkCount, selectedWork } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section
  id="work"
  class="border-line bg-paper/40 rounded-3xl border p-8 shadow-sm backdrop-blur sm:p-12"
>
  <SectionHeading eyebrow={t('home.selectedWork')} />
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      selectedWork.map((entry, index) => (
        <div data-aos="fade-up" data-aos-delay={index * 300}>
          <WorkRow entry={entry} />
        </div>
      ))
    }
  </div>
  {
    allWorkCount > selectedWork.length && (
      <div class="border-line/60 mt-8 border-t pt-6">
        <a
          href={getRelativeLocaleUrl(currentLang, 'work')}
          class="group border-line bg-paper/60 text-ink inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium shadow-xs transition-all duration-300 hover:border-[#7b7bff] hover:bg-[#7b7bff] hover:text-white hover:shadow-md"
        >
          <span>{t('home.viewAll')}</span>
          <svg
            class="text-ink-soft h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    )
  }
</section>
