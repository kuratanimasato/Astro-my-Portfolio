---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';
import { Image } from 'astro:assets';
import { getLangFromUrl } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, date, tags, cover } = entry.data;

const currentLang = getLangFromUrl(Astro.url);
const workUrl = getRelativeLocaleUrl(currentLang, `work/${entry.id}`);
const stamp = formatDate(date, 'compact');
---

<a
  href={workUrl}
  class="group relative block overflow-hidden rounded-2xl border border-line bg-surface"
>
  <!-- Cover -->
  {cover && (
    <div class="relative overflow-hidden">
      <Image
        src={cover}
        alt={`${title}の制作実績`}
        class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />

      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/30 to-transparent"
      ></div>
    </div>
  )}

  <!-- Content -->
  <div class="p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h3
          class="font-display text-ink text-xl font-semibold transition-colors group-hover:text-signal"
        >
          {title}
        </h3>

        <p class="text-ink-soft mt-3 text-sm leading-relaxed">
          {summary}
        </p>
      </div>

      <!-- Arrow -->
      <span
        aria-hidden="true"
        class="text-ink-soft shrink-0 text-xl transition-transform duration-300 group-hover:translate-x-1 group-hover:text-signal"
      >
        →
      </span>
    </div>

    <!-- Tags -->
    <div class="mt-5 flex flex-wrap gap-2">
      {tags.slice(0, 5).map((tag) => (
        <span
          class="border-line bg-surface-soft text-ink-soft rounded-full border px-3 py-1 font-mono text-[11px]"
        >
          {tag}
        </span>
      ))}
    </div>

    <!-- Date -->
    <div class="text-ink-soft mt-4 font-mono text-[11px]">
      {stamp}
    </div>
  </div>
</a>
