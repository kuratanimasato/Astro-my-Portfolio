---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// 表示したいスキルのリスト（カテゴリ分けの例）
const skillCategories = [
  {
    title: 'Frontend / Frameworks',
    items: ['HTML / CSS', 'JavaScript', 'TypeScript', 'Astro', 'React', 'Tailwind CSS'],
  },
  {
    title: 'Design / Tools',
    items: ['Figma', 'UI/UX Design', 'Wireframing', 'Prototyping'],
  },
  {
    title: 'Other',
    items: ['Git', 'GitHub', 'Node.js', 'Vercel'],
  },
];
---

<BaseLayout title={t('skills.title')} description={t('skills.description')}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">
      {t('nav.skills')}
    </p>

    <h1 class="font-display text-ink mb-12 max-w-xl text-3xl font-medium sm:text-4xl">
      {t('skills.title')}
    </h1>

    <div class="space-y-12">
      {
        skillCategories.map((category) => (
          <div>
            <h2 class="text-ink border-line mb-4 border-b pb-2 text-lg font-medium">
              {category.title}
            </h2>
            <ul class="mt-4 flex flex-wrap gap-3">
              {category.items.map((item) => (
                <li class="border-line bg-paper/50 text-ink-soft hover:text-ink hover:border-signal rounded-full border px-4 py-1.5 text-sm transition-colors">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
