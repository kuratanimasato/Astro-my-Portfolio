---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SKILL_CATEGORIES } from '@/site.config';
---

<BaseLayout title="Skill" description="私が普段使用している技術やツールの一覧です。">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-24 sm:pt-24">
    <h1 class="text-ink-soft scroll mt-3.5 font-mono text-xl tracking-[0.2em] uppercase">スキル</h1>
    <div class="space-y-10">
      {
        SKILL_CATEGORIES.map((category) => (
          <div>
            <h2 class="text-ink border-line mb-4 border-b pb-2 text-lg font-medium">
              {category.title}
            </h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
              {category.skills.map((item) => (
                <div class="border-line bg-paper/60 hover:border-signal/50 relative flex items-center gap-3 rounded-xl border p-3 shadow-xs transition-all duration-200 hover:-translate-y-0.5">
                  <div class="border-line/50 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border bg-white p-2 shadow-xs">
                    <img src={item.icon} alt={item.name} class="h-full w-full object-contain" />
                  </div>
                  <div class="flex flex-col justify-between overflow-hidden">
                    <span class="text-ink truncate text-xs font-medium sm:text-sm">
                      {item.name}
                    </span>

                    <div class="mt-1 flex items-center gap-0.5 text-xs">
                      {[1, 2, 3].map((star) => (
                        <span class={star <= item.level ? 'text-amber-400' : 'text-line'}>★</span>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
