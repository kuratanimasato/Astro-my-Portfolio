---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const tools = ['TypeScript', 'Astro', 'React', 'Figma', 'Tailwind CSS', 'Node.js'];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">
      {t('about.eyebrow')}
    </p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {t(SITE.role)}
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        私はほとんどのプロジェクトを、問題の最小単位、つまり実際に重要な1つの画面、1つのフロー、または1つの修正点を見つけることから始め、それを最初に適切に構築してから、徐々に範囲を広げていきます。
      </p>
      <p>
        それは通常、キックオフ資料で約束された機能よりも少ない機能しか搭載せず、ユーザーが常に操作する部分、つまり読み込み時間、初期状態、エラーメッセージなど、ソフトウェアの使いやすさを静かに左右する要素に重点を置くことを意味します。
      </p>
      <p>
        クライアント業務や製品開発業務以外では、いくつかの小規模なオープンソースツールを管理しており、それらを開発する過程で学んだことを時折メモにまとめています。
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">
        {t('about.tools')}
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">
      {t('about.contact')}
    </Button>
  </section>
</BaseLayout>
