---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Work"
  description="Selected projects in product design and frontend engineering."
>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow={t('work.allWork')} count={allWork.length} />
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {allWork.map((entry) => <WorkRow entry={entry} />)}
    </div>
  </section>
</BaseLayout>
