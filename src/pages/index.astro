---
import { SITE } from '@/site.config';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutCard from '@/components/AboutCard.astro';
import WorkSection from '@/components/WorkSection.astro';
import SkillsCard from '@/components/SkillsCardItem.astro';
import ContactCard from '@/components/ContactCard.astro';
import HeroGeometry from '@/components/HeroGeometry.astro';
import Scroll from '@/components/Scroll.astro';
import WorkButton from '@/components/Work.Button.astro';
import TagLine from '@/components/TagLine.astro';
const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => {
  const timeA = a.data.date ? a.data.date.valueOf() : 0;
  const timeB = b.data.date ? b.data.date.valueOf() : 0;
  return timeB - timeA;
});
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 3);
---

<BaseLayout title={SITE.name}>
  <!-- 画面全体を中央寄せ＆最大幅（max-w-6xl または max-w-5xl）で囲む -->
  <div class="mx-auto max-w-6xl space-y-12 px-4 py-8 sm:space-y-16 sm:px-6">
    <!-- HERO SECTION -->
    <!-- relative を追加し、Scroll や HeroGeometry の基準にします -->
    <section id="home" class="relative flex min-h-[calc(100vh-5rem)] items-center px-2 py-20">
      <HeroGeometry />
      <div>
        <TagLine />
        <WorkButton />
      </div>

      <!-- スクロールダウン指示をヒーローセクションの中に配置 -->
      <Scroll />
    </section>

    <!-- ABOUT SECTION -->
    <AboutCard />

    <!-- WORK SECTION -->
    <WorkSection allWorkCount={allWork.length} selectedWork={selected} />

    <!-- SKILLS SECTION -->
    <SkillsCard />

    <!-- CONTACT SECTION -->
    <ContactCard />
  </div>
</BaseLayout>
