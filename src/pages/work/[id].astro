---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { formatDate } from '@/utils/formatDate';
import ImageSlider from '@/components/ImageSlider.astro';

import { getLangFromUrl, useTranslations } from '@/i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, role, date, tags = [], url, repo, cover, images = [] } = entry.data;
const { Content } = await render(entry);

const sliderImages = images.length > 0 ? images : cover ? [cover] : [];

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const formattedDate = formatDate(date);
---

<BaseLayout title={title} description={summary}>
  <div class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <!-- 全体を囲む大きな枠 -->
    <article class="border-line bg-paper/40 rounded-3xl border p-8 shadow-sm backdrop-blur sm:p-12">
      <a href="../" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
        {t('work.back')}
      </a>

      <!-- タイトル & サマリー（枠内に綺麗に収まるよう配置） -->
      <header class="mt-6 mb-8">
        <h1 class="font-display text-ink text-3xl font-medium sm:text-4xl">
          {title}
        </h1>
        {
          summary && (
            <p class="text-ink-soft mt-3 text-base leading-relaxed sm:text-lg">{summary}</p>
          )
        }
      </header>

      <!-- 画像スライダー -->
      <div class="overflow-hidden rounded-2xl">
        <ImageSlider images={sliderImages} title={title} alt={`${title}の制作実績`} />
      </div>
      <!-- メタ情報 -->
      <dl
        class="border-line text-ink-soft mt-8 flex flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs"
      >
        <div><dt class="inline">Role —</dt><dd class="inline">{role}</dd></div>
        <div><dt class="inline">Date —</dt><dd class="inline">{formattedDate}</dd></div>
        {
          tags.length > 0 && (
            <div>
              <dt class="inline">Stack — </dt>
              <dd class="inline">{tags.join(', ')}</dd>
            </div>
          )
        }
      </dl>

      <!-- 本文 (MDX / Markdown) -->
      <div class="prose prose-sm sm:prose-base text-ink mt-10 max-w-none">
        <Content />
      </div>

      <!-- アクションボタン -->
      {
        (url || repo) && (
          <div class="border-line mt-10 flex flex-wrap gap-3 border-t pt-8">
            {url && (
              <Button href={url} variant="solid">
                リンクを見る →
              </Button>
            )}
            {repo && (
              <Button href={repo} variant="ghost">
                ソースコード
              </Button>
            )}
          </div>
        )
      }
    </article>
  </div>
</BaseLayout>
