---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return paginate(allWork, {
    pageSize: 8,
  });
};

const { page } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface Props {
  page: Page<CollectionEntry<'work'>>;
}
---

<BaseLayout
  title="Work"
  description="Selected projects in product design and frontend engineering."
>
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow={t('work.allWork')} />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {page.data.map((entry) => <WorkRow entry={entry} />)}
    </div>

    {
      page.lastPage > 1 && (
        <nav
          aria-label="Pagination"
          class="mt-12 flex items-center justify-center gap-6 font-mono text-xl"
        >
          {page.url.prev ? (
            <a href={page.url.prev} class="text-ink-soft hover:text-signal transition-colors">
              ← 前へ
            </a>
          ) : (
            <span class="text-ink-soft/30">← 前へ</span>
          )}

          <span class="text-ink-soft">
            {String(page.currentPage).padStart(2, '0')}
            {' / '}
            {String(page.lastPage).padStart(2, '0')}
          </span>

          {page.url.next ? (
            <a href={page.url.next} class="text-ink-soft hover:text-signal transition-colors">
              次へ →
            </a>
          ) : (
            <span class="text-ink-soft/30">次へ →</span>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>
